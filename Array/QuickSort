vector<int>arr{2,5,1,9,3,8};

void swap(vector<int>&arr,int l,int h){
    int temp = arr[l];
    arr[l] = arr[h];
    arr[h] = temp;
}

int partition (int l,int h){
    int pivot = arr[l];
    int i=l;
    int j=h;
    while(i<j){
        while(arr[i]<=pivot)i++;
        while(arr[j] > pivot)j--;
        if(i<j)
            swap(arr,i,j);
    }
    swap(arr,j,l);
    return j;
}

void QuickSort(int l,int h){
    if(l<h){
        int pivot = partition(l,h);
        QuickSort(l,pivot-1);
        QuickSort(pivot+1,h);
    }
}

int main() {
    // Write C++ code here
    QuickSort(0,arr.size()-1);
    
    for(int ele : arr)
        cout<<ele<<' ';
    
    cout<<endl;

    return 0;
}

