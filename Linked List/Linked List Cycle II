Given the head of a linked list, return the node where the cycle begins. If there is no cycle, return null.



 ListNode *detectCycle(ListNode *head) {
        
       ListNode* slow = head;
       ListNode* fast = head;
       ListNode* entry = head;
        
       while(fast && fast->next){
           slow = slow->next;
           fast = fast->next->next;
           
           if(slow == fast){
               while(slow != entry){
                   slow = slow->next;
                   entry=entry->next;
               }
               return entry;
           }
           
       }
        return nullptr;
        
        
        
    }
