/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */


class Solution {
public:
    ListNode* reverseList(ListNode* head) {
        if(!head)return head;
        stack<ListNode*> st;
        ListNode *temp,*temp2;
        temp = head;
        
        while(temp){
            st.push(temp);
            temp=temp->next;
        }
        
        head = st.top();
        st.pop();
        temp2 = head;
        
        while(!st.empty()){
            temp = st.top();
            temp2->next = temp;
            st.pop();
            temp2 = temp2->next;
        }
        temp2->next = nullptr;
        return head;
    }
};
