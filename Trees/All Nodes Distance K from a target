Given the root of a binary tree, the value of a target node target, and an integer k,
return an array of the values of all nodes that have a distance k from the target node.

You can return the answer in any order.



 vector<int> ans;
    void scanDown(TreeNode* root,int k){
        
        if(root == NULL || k<0)return;
        
        if(k==0){
            ans.push_back(root->val);
        }
        
        scanDown(root->left,k-1);
        scanDown(root->right,k-1);
    }
    
  int  helper(TreeNode* root,TreeNode * target, int k){
        if(root == NULL)return -1;
        
        if(root == target){
            scanDown(root,k);
            return 0 ;
        }
        int dl = helper(root->left,target,k);
        
        if(dl!=-1){
            if(dl + 1 == k){
                ans.push_back(root->val);
            }
            else{
                scanDown(root->right,k-2-dl);
            }
            return dl + 1;
        }
        int dr = helper(root->right,target,k);
        
        if(dr!=-1){
            if(dr + 1 == k){
                ans.push_back(root->val);
            }
            else{
                scanDown(root->left,k-2-dr);
            }
            return dr + 1;
        }
        return -1;
        
            
    }
    
    
    vector<int> distanceK(TreeNode* root, TreeNode* target, int k) {
        helper(root,target,k);
        return ans;
    }
    *************************************************************************
    O(N)
