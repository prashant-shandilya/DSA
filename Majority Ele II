Given an integer array of size n, find all elements that appear more than ⌊ n/3 ⌋ times.


  
    vector<int> majorityElement(vector<int>& nums) {
        
     int num1=-1,num2=-2,cnt1=0,cnt2=0;
        
        for(int i=0;i<nums.size();i++){
            int ele = nums[i];
            
            if(num1 == ele)cnt1++;
            else if (num2 == ele)cnt2++;
            else if (cnt1 == 0){
                num1 = ele;
                cnt1 = 1;
            }
            else if (cnt2 == 0){
                num2 = ele;
                cnt2 = 1;
            }
            else{
                cnt1--;
                cnt2--;
            }
            
        }
        int tot = nums.size()/3;
        cnt1 = 0;cnt2 = 0;
        
        for(int i=0;i<nums.size();i++){
            if(nums[i] == num1)cnt1++;
            
            if(nums[i] == num2)cnt2++;
        }
        
        vector<int> ans;
        
        if(cnt1 > tot)
            ans.push_back(num1);
        
        if(cnt2 > tot)
            ans.push_back(num2);
        
        return ans;
        
    }
    
