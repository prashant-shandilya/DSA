
Number of Closed Islands :-Given a 2D grid consists of 0s (land) and 1s (water).  An island is a maximal 4-directionally connected group of 0s and a closed
island is an island totally (all left, top, right, bottom) surrounded by 1s.





    void dfs(int i,int j,int n,int m,vector<vector<int>>& grid){
        
       if( i<0 || j<0 || i>=n || j>= m || grid[i][j] == 1)return;
        
       grid[i][j] = 1;
        
        dfs(i+1,j,n,m,grid);
        dfs(i,j+1,n,m,grid);
        dfs(i-1,j,n,m,grid);
        dfs(i,j-1,n,m,grid);
    }
     
    int closedIsland(vector<vector<int>>& grid) {
        
       int n = grid.size();
       int m = grid[0].size();
        
        // Firstly run through the boundry and call dfs on 0 so 
        // that the attatched land are converted to land.
        
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(i*j==0 || i == n-1 || j==m-1)
                    dfs(i,j,n,m,grid);
            }
        }
            
        int ans = 0;
    // now we only attack the real islands.
        
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j] == 0){
                    ans++;dfs(i,j,n,m,grid);
                }
                
            }
        }
        return ans;
    }
