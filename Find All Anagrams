Given two strings s and p, return an array of all the start indices of p's anagrams in s. You may return the answer in any order.


 vector<int> findAnagrams(string s, string p) {
        
       vector<int>hash(26,0);
       vector<int>phash(26,0);
        
       
        
        int start = 0,end = 0;
         vector<int> ans;
        
        if(s.size() < p.size()){
            return ans;
        }
       
        while(end<p.size()){
            phash[p[end]-'a']++;
            hash[s[end]-'a']++;
            end++;
        }
        end--;
        
        while(end<s.size()){
            
            if(hash == phash){ans.push_back(start);}
            
             end++; 
              if(end != s.size())
              { hash[s[end]-'a']++;}
            
            hash[s[start]-'a']--;
            start++;
        }
         
        return ans;
        
    }
    
