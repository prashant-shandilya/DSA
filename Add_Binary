/**
 * @param {string} a
 * @param {string} b
 * @return {string}
 */

 var addBinary = function(a, b) {
    
    let carry = '0';
    
    let arr1 = a.split('');
    let arr2 = b.split('');
    let i = arr1.length-1;
    let j = arr2.length-1;
    ans = [];

    
    while(i>=0&&j>=0){
      
        if(arr1[i]=='1'&&arr2[j]=='1'){
           if(carry=='1'){
               ans.unshift('1');
               carry='1';
           }
            else{
                ans.unshift('0');
                carry='1';
            }
        }
        else if(arr1[i]=='1'||arr2[j]=='1'){
             if(carry=='1'){
               ans.unshift('0');
                 carry = '1';
           }
            else{
                ans.unshift('1');
            }
        }
        else{
            if(carry=='1'){
                ans.unshift('1');
                carry = '0';
            }
            else{
                ans.unshift('0');
            }
        }
        
        i--;
        j--;

    }
    
    while(j>=0){
        if(carry=='1'){
        if(arr2[j]=='1'){
            ans.unshift('0');
            carry='1';
        }
        else{
            ans.unshift('1');
            carry = '0';
        }
    }
    else{
        ans.unshift(arr2[j]);
    }
        j--;
        if(carry=='1'&&j<0){ans.unshift('1');carry='0';}
    }

    while(i>=0){
        if(carry=='1'){
            if(arr1[i]=='1'){
                ans.unshift('0');
                carry='1';
            }
            else{
                ans.unshift('1');
                carry = '0';
            }
        }
     else{
         ans.unshift(arr1[i]);
     }
        i--;
        if(carry=='1'&&i<0){ans.unshift('1');carry='0';}
    }
     
    if(carry=='1')ans.unshift('1');
     // console.log(ans.join(''));
     return ans.join('');
};



