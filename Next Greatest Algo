/**
 * @param {number[]} nums1
 * @param {number[]} nums2
 * @return {number[]}
 */

var nextGreaterElement = function(nums1, nums2) {
    var ans={};
    // var go = {};
  
    var st = [];
    
    st.push(nums2[0]);
    
    for(let i=1;i<nums2.length;i++){

      if(st.length==0){
        st.push(nums2[i]);
        continue;
      }
        
        while(st.length!=0 && st[st.length-1]<nums2[i]){
            
            ans[st[st.length-1]] = nums2[i];
            st.pop();
            
        }
        
        st.push(nums2[i]);
        
    }

    while(st.length!=0){
       ans[st[st.length-1]] = -1;
      st.pop();
    }
    let go = [];
  
    for(let i = 0;i<nums1.length;i++){
         go.push(ans[nums1[i]]);
    }
  
    return go;
    
};

