class Solution {
public:
    vector<vector<int>> ans;
    
    void helper(vector<int> nums, int l, int r){
        int aux;
        if(l == r){
            ans.push_back(nums);
        }
        else{
            for(int i=l;i<=r;i++){
                aux = nums[l];
                nums[l] = nums[i];
                nums[i] = aux;
                helper(nums,l+1,nums.size()-1);
                aux = nums[l];
                nums[l] = nums[i];
                nums[i] = aux;
            }
        }
    }

       
    vector<vector<int>> permute(vector<int>& nums) {
      
        helper(nums,0,nums.size()-1);
        
        return ans;
        
        
    }
    
    
};
