/**
 * @param {string} num1
 * @param {string} num2
 * @return {string}
 */


var addStrings = function(num1, num2) {
       
    let i = num1.length-1;
    let j = num2.length-1;
    let carry = 0;
    let res = [];
    let sum = 0;
    
    while(i>=0||j>=0){
        
        
        if(i>=0)
        sum+=Number(num1[i--]);
        
        if(j>=0)
        sum+=Number(num2[j--]);
        
        sum+=carry;
        
        carry = sum>9?1:0;
        
        res.push(sum%10);
        
        sum = 0;
        
    }
    if(carry)res.push(carry);
    
    return res.reverse().join('')
    
    
};
*****************************************************************************************************************************************************************
Given two number strings add them without using the number().
