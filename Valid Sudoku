    
    int getBit(int x,int y){
        return (x >> y) & 1;
    }
    
    
    bool isValidSudoku(vector<vector<char>>& board) {
        int N = 9;
        vector<int> rows(N),cols(N),square(N);
        
        for(int r=0;r<N;r++){
            for(int c=0;c<N;c++){
                if(board[r][c] == '.')continue;
                int val = board[r][c] - '0';
                int indx = (r/3)*3 + (c/3);
                if(getBit(rows[r],val)||getBit(cols[c],val)||getBit(square[indx],val))
                    return false;
               
                rows[r] |= 1 << val;
                cols[c] |= 1 << val;
                square[indx] |= 1 << val;
                
            }
        }
        return true;
        
        
    }
    *******************************************************************
    each entry in the rows is the state of the number 
    the i'th number represents if that number is present or not.
